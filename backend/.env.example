# Database Configuration
DATABASE_URL=postgresql+psycopg2://qauser:securepassword123@db:5432/qadb
POSTGRES_USER=qauser
POSTGRES_PASSWORD=securepassword123
POSTGRES_DB=qadb

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Security — IMPORTANT: Change ALL secrets to strong random values in production!
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-super-secret-key-change-in-production-keep-this-very-secure
ADMIN_JWT_SECRET=change-me-to-a-strong-random-value
USER_JWT_SECRET=change-me-to-a-different-strong-random-value
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# JWT & Token Configuration
JWT_ALGORITHM=HS256


# Admin Console
# The initial admin username is: admin
ADMIN_INITIAL_PASSWORD=changeme123

# Logging
LOG_LEVEL=INFO

# Reverse Proxy — set this if running behind a reverse proxy (nginx, traefik, etc.)
# so that real client IP addresses are logged instead of the proxy IP.
# Comma-separated list of trusted proxy IPs or CIDR ranges.
# Examples:
#   TRUSTED_PROXIES=172.16.0.0/12           (Docker default bridge network)
#   TRUSTED_PROXIES=10.0.0.1,172.18.0.0/16  (specific proxy + Docker network)
#   TRUSTED_PROXIES=*                        (trust all — use only if fully behind a known proxy)
# TRUSTED_PROXIES=

# Scheduler
SCHEDULE_INTERVAL_SECONDS=86400

# Environment
DEBUG=False

# ============= Firebase Cloud Messaging (FCM) - Optional =============
# To enable push notifications, configure these variables:
# 
# FCM_PROJECT_ID: Your Firebase project ID (found in Firebase Console -> Project Settings)
# FCM_PROJECT_ID=your-firebase-project-id
#
# FCM_SERVICE_ACCOUNT_JSON: The full JSON content of your service account key
# Get it from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"...",...}
#
# Alternative: Use GOOGLE_APPLICATION_CREDENTIALS with path to JSON file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json